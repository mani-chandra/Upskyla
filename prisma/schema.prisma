generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Announcement {
  id        String   @id
  title     String
  content   String
  module    String   @default("GLOBAL")
  createdAt DateTime @default(now())
}

model ComplaintTicket {
  id          String          @id
  userId      String
  subject     String
  description String
  status      ComplaintStatus @default(OPEN)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime
  User        User            @relation(fields: [userId], references: [id])
}

model ConsultationBooking {
  id        String        @id
  userId    String
  date      DateTime
  status    BookingStatus @default(PENDING)
  notes     String?
  paymentId String?       @unique
  createdAt DateTime      @default(now())
  Payment   Payment?      @relation(fields: [paymentId], references: [id])
  User      User          @relation(fields: [userId], references: [id])
}

model Coupon {
  id        String    @id
  userId    String
  code      String    @unique
  amount    Float     @default(1000)
  isUsed    Boolean   @default(false)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  User      User      @relation(fields: [userId], references: [id])
}

model Course {
  id            String       @id
  title         String
  description   String
  price         Float
  thumbnail     String?
  createdAt     DateTime     @default(now())
  curriculumPdf String?
  Enrollment    Enrollment[]
  Lesson        Lesson[]
}

model Enrollment {
  id         String   @id
  userId     String
  courseId   String
  progress   Int      @default(0)
  completed  Boolean  @default(false)
  paymentId  String?  @unique
  enrolledAt DateTime @default(now())
  Course     Course   @relation(fields: [courseId], references: [id])
  Payment    Payment? @relation(fields: [paymentId], references: [id])
  User       User     @relation(fields: [userId], references: [id])
}

model Exam {
  id          String        @id
  title       String
  description String?
  duration    Int
  questions   Json
  createdAt   DateTime      @default(now())
  ExamAttempt ExamAttempt[]
}

model ExamAttempt {
  id          String   @id
  userId      String
  examId      String
  score       Int
  answers     Json
  completedAt DateTime @default(now())
  Exam        Exam     @relation(fields: [examId], references: [id])
  User        User     @relation(fields: [userId], references: [id])
}

model FeatureFlag {
  id          String   @id
  name        String   @unique
  isEnabled   Boolean  @default(true)
  description String?
  updatedAt   DateTime
}

model GamingBooking {
  id        String        @id
  userId    String
  slot      DateTime
  duration  Int
  status    BookingStatus @default(PENDING)
  createdAt DateTime      @default(now())
  User      User          @relation(fields: [userId], references: [id])
}

model HostelBooking {
  id            String        @id
  userId        String        @unique
  roomNumber    String
  status        BookingStatus @default(PENDING)
  checkIn       DateTime
  checkOut      DateTime?
  paymentId     String?       @unique
  isCheckedIn   Boolean       @default(false)
  firstRentPaid Boolean       @default(false)
  createdAt     DateTime      @default(now())
  Payment       Payment?      @relation(fields: [paymentId], references: [id])
  User          User          @relation(fields: [userId], references: [id])
}

model JobApplication {
  id         String        @id
  jobId      String
  userId     String
  resumeUrl  String
  status     BookingStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  JobListing JobListing    @relation(fields: [jobId], references: [id])
  User       User          @relation(fields: [userId], references: [id])
}

model JobListing {
  id             String           @id
  title          String
  company        String
  description    String
  location       String
  salary         String?
  createdAt      DateTime         @default(now())
  JobApplication JobApplication[]
}

model Lesson {
  id        String   @id
  courseId  String
  title     String
  videoUrl  String
  order     Int
  createdAt DateTime @default(now())
  Course    Course   @relation(fields: [courseId], references: [id])
}

model Payment {
  id                  String               @id
  amount              Float
  currency            String               @default("INR")
  provider            String               @default("RAZORPAY")
  providerId          String               @unique
  status              String
  createdAt           DateTime             @default(now())
  ConsultationBooking ConsultationBooking?
  Enrollment          Enrollment?
  HostelBooking       HostelBooking?
  TaxiBooking         TaxiBooking?
}

model Profile {
  id        String  @id
  userId    String  @unique
  phone     String?
  address   String?
  avatar    String?
  resumeUrl String?
  User      User    @relation(fields: [userId], references: [id])
}

model Referral {
  id                                 String         @id
  referrerId                         String
  referredUserId                     String         @unique
  status                             ReferralStatus @default(REGISTERED)
  rewardAmount                       Float          @default(750)
  createdAt                          DateTime       @default(now())
  updatedAt                          DateTime
  User_Referral_referredUserIdToUser User           @relation("Referral_referredUserIdToUser", fields: [referredUserId], references: [id])
  User_Referral_referrerIdToUser     User           @relation("Referral_referrerIdToUser", fields: [referrerId], references: [id])
}

model TaxiBooking {
  id         String        @id
  userId     String
  vehicleId  String?
  type       String
  pickupTime DateTime
  status     BookingStatus @default(PENDING)
  paymentId  String?       @unique
  createdAt  DateTime      @default(now())
  Payment    Payment?      @relation(fields: [paymentId], references: [id])
  User       User          @relation(fields: [userId], references: [id])
  Vehicle    Vehicle?      @relation(fields: [vehicleId], references: [id])
}

model TheatreBooking {
  id        String        @id
  userId    String
  slot      DateTime
  duration  Int
  status    BookingStatus @default(PENDING)
  createdAt DateTime      @default(now())
  User      User          @relation(fields: [userId], references: [id])
}

model User {
  id                                     String                @id
  email                                  String                @unique
  password                               String
  name                                   String?
  role                                   Role                  @default(STUDENT)
  createdAt                              DateTime              @default(now())
  updatedAt                              DateTime
  resetToken                             String?               @unique
  resetTokenExpiry                       DateTime?
  referralCode                           String                @unique
  referredByCode                         String?
  ComplaintTicket                        ComplaintTicket[]
  ConsultationBooking                    ConsultationBooking[]
  Coupon                                 Coupon[]
  Enrollment                             Enrollment[]
  ExamAttempt                            ExamAttempt[]
  GamingBooking                          GamingBooking[]
  HostelBooking                          HostelBooking?
  JobApplication                         JobApplication[]
  Profile                                Profile?
  Referral_Referral_referredUserIdToUser Referral?             @relation("Referral_referredUserIdToUser")
  Referral_Referral_referrerIdToUser     Referral[]            @relation("Referral_referrerIdToUser")
  TaxiBooking                            TaxiBooking[]
  TheatreBooking                         TheatreBooking[]
  Wallet                                 Wallet?
  WalletTransaction                      WalletTransaction[]
}

model Vehicle {
  id           String        @id
  name         String
  type         String
  plateNumber  String        @unique
  isAvailable  Boolean       @default(true)
  pricePerHour Float
  TaxiBooking  TaxiBooking[]
}

model Wallet {
  id      String @id
  userId  String @unique
  balance Float  @default(0)
  User    User   @relation(fields: [userId], references: [id])
}

model WalletTransaction {
  id         String                  @id
  userId     String
  amount     Float
  type       WalletTransactionType
  status     WalletTransactionStatus @default(PENDING)
  referralId String?
  createdAt  DateTime                @default(now())
  User       User                    @relation(fields: [userId], references: [id])
}

enum BookingStatus {
  PENDING
  APPROVED
  CANCELLED
  COMPLETED
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum ReferralStatus {
  REGISTERED
  ADVANCE_PAID
  CHECKED_IN
  REWARD_CREDITED
  ELIGIBLE_FOR_WITHDRAWAL
}

enum Role {
  STUDENT
  ADMIN
  STAFF
}

enum WalletTransactionStatus {
  PENDING
  APPROVED
  WITHDRAWN
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}
