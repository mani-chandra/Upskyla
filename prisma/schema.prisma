generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  module    String   @default("GLOBAL")
  createdAt DateTime @default(now())
}

model ComplaintTicket {
  id          String          @id @default(cuid())
  userId      String
  subject     String
  description String
  status      ComplaintStatus @default(OPEN)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id])
}

model ConsultationBooking {
  id        String        @id @default(cuid())
  userId    String
  date      DateTime
  status    BookingStatus @default(PENDING)
  notes     String?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id])
  payment   Payment?
}

model Coupon {
  id        String    @id @default(cuid())
  userId    String
  code      String    @unique
  amount    Float     @default(1000)
  isUsed    Boolean   @default(false)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
}

model Course {
  id            String       @id @default(cuid())
  title         String
  description   String
  price         Float
  thumbnail     String?
  createdAt     DateTime     @default(now())
  curriculumPdf String?
  enrollments   Enrollment[]
  lessons       Lesson[]
}

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  progress   Int      @default(0)
  completed  Boolean  @default(false)
  enrolledAt DateTime @default(now())
  course     Course   @relation(fields: [courseId], references: [id])
  user       User     @relation(fields: [userId], references: [id])
  payment    Payment?
}

model Exam {
  id          String        @id @default(cuid())
  title       String
  description String?
  duration    Int
  questions   Json
  createdAt   DateTime      @default(now())
  attempts    ExamAttempt[]
}

model ExamAttempt {
  id          String   @id @default(cuid())
  userId      String
  examId      String
  score       Int
  answers     Json
  completedAt DateTime @default(now())
  exam        Exam     @relation(fields: [examId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  name        String   @unique
  isEnabled   Boolean  @default(true)
  description String?
  updatedAt   DateTime @updatedAt
}

model GamingBooking {
  id        String        @id @default(cuid())
  userId    String
  slot      DateTime
  duration  Int
  status    BookingStatus @default(PENDING)
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id])
}

model HostelBooking {
  id             String        @id @default(cuid())
  userId         String        @unique
  roomNumber     String?
  status         BookingStatus @default(PENDING)
  approxCheckIn  DateTime
  actualCheckIn  DateTime?
  checkOut       DateTime?
  advancePaid    Boolean       @default(false)
  firstRentPaid  Boolean       @default(false)
  isCheckedIn    Boolean       @default(false)
  rentDueDate    DateTime?
  lastRentPaidAt DateTime?
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id])
  payments       Payment[]
}

model JobApplication {
  id        String        @id @default(cuid())
  jobId     String
  userId    String
  resumeUrl String
  status    BookingStatus @default(PENDING)
  createdAt DateTime      @default(now())
  job       JobListing    @relation(fields: [jobId], references: [id])
  user      User          @relation(fields: [userId], references: [id])
}

model JobListing {
  id           String           @id @default(cuid())
  title        String
  company      String
  description  String
  location     String
  salary       String?
  createdAt    DateTime         @default(now())
  applications JobApplication[]
}

model Lesson {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  videoUrl  String
  order     Int
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id])
}

model Payment {
  id             String               @id @default(cuid())
  userId         String
  amount         Float
  currency       String               @default("INR")
  provider       String               @default("RAZORPAY")
  providerId     String               @unique
  status         String
  type           PaymentType          @default(OTHER)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  consultationId String?              @unique
  enrollmentId   String?              @unique
  hostelId       String?
  taxiId         String?              @unique
  consultation   ConsultationBooking? @relation(fields: [consultationId], references: [id])
  enrollment     Enrollment?          @relation(fields: [enrollmentId], references: [id])
  hostel         HostelBooking?       @relation(fields: [hostelId], references: [id])
  taxi           TaxiBooking?         @relation(fields: [taxiId], references: [id])
  user           User                 @relation(fields: [userId], references: [id])
}

model Profile {
  id        String  @id @default(cuid())
  userId    String  @unique
  phone     String?
  address   String?
  avatar    String?
  resumeUrl String?
  user      User    @relation(fields: [userId], references: [id])
}

model Referral {
  id             String         @id @default(cuid())
  referrerId     String
  referredUserId String         @unique
  status         ReferralStatus @default(REGISTERED)
  rewardAmount   Float          @default(750)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  referredUser   User           @relation("ReferredUser", fields: [referredUserId], references: [id])
  referrer       User           @relation("Referrer", fields: [referrerId], references: [id])
}

model TaxiBooking {
  id         String        @id @default(cuid())
  userId     String
  vehicleId  String?
  type       String
  pickupTime DateTime
  status     BookingStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  payment    Payment?
  user       User          @relation(fields: [userId], references: [id])
  vehicle    Vehicle?      @relation(fields: [vehicleId], references: [id])
}

model TheatreBooking {
  id        String        @id @default(cuid())
  userId    String
  slot      DateTime
  duration  Int
  status    BookingStatus @default(PENDING)
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model User {
  id                 String                @id @default(cuid())
  email              String                @unique
  password           String
  name               String?
  image              String?
  role               Role                  @default(STUDENT)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  resetToken         String?               @unique
  resetTokenExpiry   DateTime?
  referralCode       String                @unique @default(cuid())
  referredByCode     String?
  complaints         ComplaintTicket[]
  consultations      ConsultationBooking[]
  coupons            Coupon[]
  enrollments        Enrollment[]
  examAttempts       ExamAttempt[]
  gamingBookings     GamingBooking[]
  hostelBooking      HostelBooking?
  jobApplications    JobApplication[]
  notifications      Notification[]
  payments           Payment[]
  profile            Profile?
  referralReceived   Referral?             @relation("ReferredUser")
  referralsMade      Referral[]            @relation("Referrer")
  taxiBookings       TaxiBooking[]
  theatreBookings    TheatreBooking[]
  wallet             Wallet?
  walletTransactions WalletTransaction[]
}

model Vehicle {
  id           String        @id @default(cuid())
  name         String
  type         String
  plateNumber  String        @unique
  isAvailable  Boolean       @default(true)
  pricePerHour Float
  bookings     TaxiBooking[]
}

model Wallet {
  id      String @id @default(cuid())
  userId  String @unique
  balance Float  @default(0)
  user    User   @relation(fields: [userId], references: [id])
}

model WalletTransaction {
  id         String                  @id @default(cuid())
  userId     String
  amount     Float
  type       WalletTransactionType
  status     WalletTransactionStatus @default(PENDING)
  referralId String?
  createdAt  DateTime                @default(now())
  user       User                    @relation(fields: [userId], references: [id])
}

enum PaymentType {
  HOSTEL_ADVANCE
  HOSTEL_RENT
  COURSE_ENROLLMENT
  CONSULTATION
  TAXI_BOOKING
  OTHER
}

enum BookingStatus {
  PENDING
  APPROVED
  CANCELLED
  COMPLETED
  ACTIVE
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum ReferralStatus {
  REGISTERED
  ADVANCE_PAID
  CHECKED_IN
  REWARD_CREDITED
  ELIGIBLE_FOR_WITHDRAWAL
}

enum Role {
  STUDENT
  ADMIN
  STAFF
  MODERATOR
}

enum WalletTransactionStatus {
  PENDING
  APPROVED
  WITHDRAWN
  CANCELLED
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}
