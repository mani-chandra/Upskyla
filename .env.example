# Database URL
DATABASE_URL="postgresql://user:password@localhost:5432/student_ecosystem?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/student_ecosystem?schema=public"

# JWT Secret
JWT_SECRET="your_jwt_secret_here"

# Razorpay Keys (Test Mode)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"

# Node Environment
NODE_ENV="development"

# App URL (for password reset links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Brevo API Key (for sending emails, free tier available)
# Get your key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY="your_brevo_api_key_here"
